# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret

# PostgreSQL (SQLAlchemy connection string)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/mahi_portfolio

# CORS - frontend origin allowed to call this API
CLIENT_ORIGIN=http://localhost:8080

# Mail (Flask-Mail / SMTP) - used to notify the site owner of new inquiries
# and to send the automatic confirmation email back to the visitor.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# The inbox that should receive new inquiries (never shown to visitors).
RECEIVER_EMAIL=mahi.patel.owner@example.com

# Admin dashboard access
ADMIN_API_KEY=change-this-to-a-long-random-admin-secret
